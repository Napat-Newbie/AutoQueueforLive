Name: "{autoprograms}\AutoQueueforLive"; Filename: "wscript.exe"; Parameters: """{app}\AutoQueueforLive.vbs"""; WorkingDir: "{app}"; IconFilename: "{app}\app_icon.ico"

[Run]
